# Copia este archivo como .env y ajusta tus credenciales locales.
# El .env NUNCA se commitea. Las variables se validan al arrancar (config/env.validation.ts).

NODE_ENV=development
PORT=3000

# Base de datos (XAMPP / MySQL local)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=marina_inteligencia

# Autenticacion
JWT_SECRET=cambiar-en-cada-entorno-minimo-32-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar-en-cada-entorno-minimo-32-caracteres
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
MAX_INTENTOS_FALLIDOS=5

# Integracion
FRONTEND_URL=http://localhost:5173
STORAGE_PATH=./storage/carteles
